# Copy to .env (or set in your host's environment) — never commit real values.
NODE_ENV=production
PORT=3000
BASE_URL=https://your-domain.example
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# Set TRUST_PROXY=true only when running behind a reverse proxy you control (for correct rate limiting by IP).
TRUST_PROXY=false
# Payments: leave blank until you connect Stripe. Orders are saved as "awaiting payment" meanwhile.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Allow the "simulate payment" button outside development (keep false in production).
ALLOW_SIMULATED_PAYMENTS=false
